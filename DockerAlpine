FROM alpine AS builder
RUN apk add --update-cache \
    bash \
    luajit \
    luajit-dev \
    sqlite \
    sqlite-dev \
    cmake \
    python3 \
    build-base \
    && rm -rf /var/cache/apk/*
WORKDIR /app
COPY . /app
ENV LUAJIT_LIBRARY=/usr/lib/libluajit-5.1.so \
    LUAJIT_INCLUDE_DIR=/usr/include/luajit-2.1 \
    LUAJIT_BIN=/usr/bin/luajit 
RUN USE_SYS_LJ=1 cmake -S . -B /tmp/build -DCMAKE_BUILD_TYPE=Release -DSQLITE_PLUGIN_LJ_PORTABLE_RPATH=ON \
    && cmake --build /tmp/build \
    && cmake --install /tmp/build \
    && ctest --test-dir /tmp/build -V


FROM scratch AS binaries
COPY --from=builder /tmp/build/libsqlite_plugin_lj.so /libsqlite_plugin_lj.so
