FROM ubuntu AS builder
RUN apt update \
&& apt install sqlite3 -y \
&& apt install libsqlite3-dev -y \
&& apt install cmake -y \
&& apt install gcc -y \
&& apt install g++ -y \
&& apt install python3 -y \
&& apt install luajit -y \
&& apt install libluajit-5.1-dev -y 

WORKDIR /app
COPY . /app
ENV LUAJIT_LIBRARY=/usr/lib/x86_64-linux-gnu/libluajit-5.1.so \
    LUAJIT_INCLUDE_DIR=/usr/include/luajit-2.1 \
    LUAJIT_BIN=/usr/bin/luajit 
RUN cmake -S . -B /tmp/build -DCMAKE_BUILD_TYPE=Release -DSQLITE_PLUGIN_LJ_PORTABLE_RPATH=ON \
    && cmake --build /tmp/build \
    && cmake --install /tmp/build \
    && ctest --test-dir /tmp/build -V

FROM scratch AS binaries
COPY --from=builder /tmp/build/libsqlite_plugin_lj.so /libsqlite_plugin_lj.so
